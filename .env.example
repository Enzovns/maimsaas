# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/mineapply"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Google OAuth
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
#                           http://localhost:3000/api/gmail/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Stripe
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Get from: https://dashboard.stripe.com/webhooks (create endpoint for /api/stripe/webhook)
STRIPE_WEBHOOK_SECRET="whsec_..."
# Create a $9.99/month recurring price at: https://dashboard.stripe.com/products
STRIPE_PRICE_ID="price_..."

# Cron secret (optional — used to secure the /api/cron/send endpoint)
CRON_SECRET="your-random-cron-secret"

# Admin email (this email gets access to /admin)
ADMIN_EMAIL="admin@yourdomain.com"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
